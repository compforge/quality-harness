{
  "name": "@compforge/harness-toolbox",
  "version": "0.1.0",
  "description": "Shared infrastructure clients, transports and bounded data capture",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json"
  },
  "exports": {
    ".": {
      "types": "./dist/datasource.d.ts",
      "import": "./dist/datasource.js"
    },
    "./datasource": {
      "types": "./dist/datasource.d.ts",
      "import": "./dist/datasource.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js"
    },
    "./process/index": {
      "types": "./dist/process/index.d.ts",
      "import": "./dist/process/index.js"
    },
    "./kubernetes/*": {
      "types": "./dist/kubernetes/*.d.ts",
      "import": "./dist/kubernetes/*.js"
    },
    "./mysql": {
      "types": "./dist/mysql/index.d.ts",
      "import": "./dist/mysql/index.js"
    },
    "./mysql/*": {
      "types": "./dist/mysql/*.d.ts",
      "import": "./dist/mysql/*.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./redis/*": {
      "types": "./dist/redis/*.d.ts",
      "import": "./dist/redis/*.js"
    },
    "./opensearch": {
      "types": "./dist/opensearch/index.d.ts",
      "import": "./dist/opensearch/index.js"
    },
    "./opensearch/*": {
      "types": "./dist/opensearch/*.d.ts",
      "import": "./dist/opensearch/*.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client-manager": {
      "types": "./dist/client-manager.d.ts",
      "import": "./dist/client-manager.js"
    },
    "./concurrency": {
      "types": "./dist/concurrency.d.ts",
      "import": "./dist/concurrency.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "mysql2": "3.23.1",
    "@redis/client": "6.1.0",
    "@opensearch-project/opensearch": "3.6.0",
    "@kubernetes/client-node": "1.4.0",
    "node-fetch": "2.7.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "@types/node-fetch": "2.6.13",
    "@types/node": "^22"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
